# NetEase Cloud Music Cookie
# Get MUSIC_U: Browser F12 -> Application -> Cookies -> music.163.com -> MUSIC_U
# Get __csrf: Browser F12 -> Application -> Cookies -> music.163.com -> __csrf
NETEASE_COOKIE=MUSIC_U=your_music_u_here; __csrf=your_csrf_here

# MCP Server Port
MCP_PORT=3456

# Long random secrets. Keep these private and use different values.
MCP_SECRET=replace_with_a_long_random_secret
NOW_PLAYING_REPORTER_SECRET=replace_with_a_different_long_random_secret
